#!/bin/sh
# Wrap system ffmpeg with nvscope so NVENC/NVDEC see container-local GPU topology.
# Installed as /usr/local/bin/ffmpeg (earlier in PATH than /usr/bin/ffmpeg).
set -eu

REAL_FFMPEG="${FFMPEG_REAL_PATH:-/usr/bin/ffmpeg}"
NVSCOPE_BIN="${NVSCOPE_BIN:-/usr/local/bin/nvscope}"
NVSCOPE_LIB="${NVSCOPE_LIB:-/usr/local/lib/nvscope/libnvscope.so}"

if [ "${NVSCOPE_DISABLED:-0}" = "1" ]; then
	exec "$REAL_FFMPEG" "$@"
fi

# FaceFusion probes encoders via `ffmpeg -encoders` when building argparse.
# nvscope LD_PRELOAD can break that introspection path; only shim encode/decode work.
for arg in "$@"; do
	case "$arg" in
		-encoders|-decoders|-codecs|-formats|-version|-hwaccels|-devices|-buildconf|-h|-help|-?)
			exec "$REAL_FFMPEG" "$@"
			;;
	esac
done

if [ -x "$NVSCOPE_BIN" ] && [ -f "$NVSCOPE_LIB" ]; then
	export NVSCOPE_LIB
	exec "$NVSCOPE_BIN" -- "$REAL_FFMPEG" "$@"
fi

exec "$REAL_FFMPEG" "$@"
